{
  "name": "@9thlevel/aegis",
  "version": "0.0.1",
  "description": "ah: a PreToolUse guard for Codex and Claude Code. Vetoes destructive commands, hook bypasses, linter and test config edits, and credential leaks, with the fixture corpus that proves it.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "ah": "dist/ah.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:hooks": "node dist/ah.mjs test-hooks",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "verify": "npm run build && npm run typecheck && npm test && npm run check:hygiene && npm run test:hooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9thLevelSoftware/aegis-harness.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "hooks",
    "PreToolUse",
    "agent",
    "guardrail",
    "harness"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
